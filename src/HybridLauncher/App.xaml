<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="HybridLauncher.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Even, faint control rims in place of WinUI's pixel-mapped elevation gradient (SmoothEdges.xaml). -->
                <ResourceDictionary Source="SmoothEdges.xaml" />
                <ResourceDictionary Source="Styles.xaml" />
                <ResourceDictionary Source="ScrollBars.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
