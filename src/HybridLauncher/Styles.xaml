<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <!-- The logo's colours: ivory letter, crimson crossbar (the fallback banner runs from a dark slate into the crimson). -->
            <Color x:Key="NeonCyan">#2A2E38</Color>
            <Color x:Key="NeonMagenta">#D7143A</Color>
            <SolidColorBrush x:Key="NeonCyanBrush" Color="#2A2E38" />
            <SolidColorBrush x:Key="NeonMagentaBrush" Color="#D7143A" />
            <!-- The wordmark: the logo's ivory, and its crimson for the bar under it. -->
            <SolidColorBrush x:Key="HybridBrush" Color="#F4EFE4" />
            <SolidColorBrush x:Key="HybridAccentBrush" Color="#D7143A" />
            <!-- Contrast (0.21): secondary and tertiary text a step brighter than WinUI's, and the rows and cards a step lighter
                 than the window, so every surface and every description reads clearly on Mica and on the colour themes. -->
            <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#D9FFFFFF" />
            <SolidColorBrush x:Key="TextFillColorTertiaryBrush" Color="#ADFFFFFF" />
            <SolidColorBrush x:Key="TextFillColorDisabledBrush" Color="#73FFFFFF" />
            <SolidColorBrush x:Key="LayerOnAcrylicFillColorDefaultBrush" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="CardBackgroundFillColorDefaultBrush" Color="#0FFFFFFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <Color x:Key="NeonCyan">#3A3F4A</Color>
            <Color x:Key="NeonMagenta">#D7143A</Color>
            <SolidColorBrush x:Key="NeonCyanBrush" Color="#3A3F4A" />
            <SolidColorBrush x:Key="NeonMagentaBrush" Color="#D7143A" />
            <SolidColorBrush x:Key="HybridBrush" Color="#17181C" />
            <SolidColorBrush x:Key="HybridAccentBrush" Color="#D7143A" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Oxanium (SIL OFL 1.1, Assets\Fonts): squared, cut-corner letters, used only by the logo wordmark. -->
    <FontFamily x:Key="CyberFont">ms-appx:///Assets/Fonts/Oxanium.ttf#Oxanium</FontFamily>

    <LinearGradientBrush x:Key="NeonBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="{ThemeResource NeonCyan}" Offset="0" />
        <GradientStop Color="{ThemeResource NeonMagenta}" Offset="1" />
    </LinearGradientBrush>

    <!-- A Windows 11 settings-style card: one rounded surface per section. -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
        <Setter Property="Padding" Value="18,14" />
    </Style>

    <!-- A row inside a card (header + description on the left, control on the right). -->
    <Style x:Key="RowStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="MinHeight" Value="52" />
    </Style>

    <!-- A group of settings inside a card: a slightly raised panel with its own small heading. -->
    <Style x:Key="GroupStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
        <Setter Property="Padding" Value="14,10,14,12" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}">
        <Setter Property="Margin" Value="0,0,0,2" />
    </Style>

    <!-- Small upper-case label above a group of settings or a block of facts. -->
    <Style x:Key="GroupHeader" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CharacterSpacing" Value="60" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style x:Key="RowHeader" TargetType="TextBlock" BasedOn="{StaticResource BodyTextBlockStyle}">
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="RowDescription" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Small square icon buttons in card headers (refresh, open folder...). -->
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- A store divider in the game list. The stock header template only shows text (it binds Content to a TextBlock);
         this one presents any content (logo + name + count), with the same pane-closed state. -->
    <Style x:Key="StoreHeaderStyle" TargetType="NavigationViewItemHeader">
        <Setter Property="Foreground" Value="{ThemeResource NavigationViewItemHeaderForeground}" />
        <Setter Property="IsEnabled" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="AutomationProperties.AccessibilityView" Value="Raw" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="NavigationViewItemHeader">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="PaneStates">
                                <VisualState x:Name="HeaderTextVisible" />
                                <VisualState x:Name="HeaderTextCollapsed">
                                    <VisualState.Setters>
                                        <Setter Target="HeaderContent.Visibility" Value="Collapsed" />
                                        <Setter Target="InnerHeaderGrid.Height" Value="0" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="DisplayModeStates">
                                <VisualState x:Name="LeftMode" />
                                <VisualState x:Name="TopMode" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid x:Name="InnerHeaderGrid" Height="36" HorizontalAlignment="Left" Margin="{ThemeResource NavigationViewItemInnerHeaderMargin}">
                            <ContentPresenter x:Name="HeaderContent" VerticalAlignment="Center" Content="{TemplateBinding Content}"
                                              Foreground="{TemplateBinding Foreground}" />
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Link buttons drawn on top of the game banner: one look for every brand (icon + label in the UI font). Their see-through
         colours come from Frosted.xaml, merged into the banner's resources. -->
    <Style x:Key="BannerButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="RequestedTheme" Value="Dark" />
        <Setter Property="Padding" Value="15,9" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- The small store chip on the banner (clickable: opens the game in its store). -->
    <Style x:Key="BannerChip" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="RequestedTheme" Value="Dark" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Buttons in the see-through launch bar (the bar is always dark, so the text is white). -->
    <Style x:Key="GlassButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <!-- A little rounder than Play, so the buttons read as soft pills beside its squared face (Hydra-like). -->
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="14,6" />
        <Setter Property="MinHeight" Value="46" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- The toggle in the launch bar (HDR). -->
    <Style x:Key="GlassToggleButton" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="MinHeight" Value="46" />
    </Style>

    <!-- The Play button: big, bold, a two-tone accent gradient and a soft lighter rim. -->
    <Style x:Key="PlayButton" TargetType="Button" BasedOn="{StaticResource AccentButtonStyle}">
        <!-- Even on both sides: the content is centred by the button, not nudged by the padding. -->
        <Setter Property="Padding" Value="30,0,30,0" />
        <Setter Property="MinHeight" Value="46" />
        <Setter Property="MinWidth" Value="148" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" /> 
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- The heading of a card that folds: the whole row is one button (one click, one toggle), with a soft hover. -->
    <Style x:Key="FoldHeaderButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="Padding" Value="6,4,6,4" />
        <Setter Property="Margin" Value="-6,-4,-6,0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="{StaticResource ControlCornerRadius}" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Background" Value="{ThemeResource SubtleFillColorTertiaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="Root.Opacity" Value="0.5" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter Margin="{TemplateBinding Padding}" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A choice drawn as a small card (the OptiScaler channels): accent outline and a check mark when picked. -->
    <Style x:Key="ChoiceCard" TargetType="RadioButton">
        <Setter Property="Background" Value="{ThemeResource LayerOnAcrylicFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="14,10,30,12" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid x:Name="CardRoot" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="CardRoot.Background" Value="{ThemeResource ControlFillColorSecondaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="CardRoot.Background" Value="{ThemeResource ControlFillColorTertiaryBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="CardRoot.Opacity" Value="0.5" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CheckStates">
                                <VisualState x:Name="Checked">
                                    <VisualState.Setters>
                                        <Setter Target="Outline.Opacity" Value="1" />
                                        <Setter Target="Check.Opacity" Value="1" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Unchecked" />
                                <VisualState x:Name="Indeterminate" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border x:Name="Outline" Margin="-1" BorderThickness="2" CornerRadius="{TemplateBinding CornerRadius}" Opacity="0"
                                BorderBrush="{ThemeResource AccentFillColorDefaultBrush}" />
                        <FontIcon x:Name="Check" Glyph="&#xEC61;" FontSize="16" Margin="0,9,10,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Opacity="0" />
                        <ContentPresenter x:Name="ContentPresenter" Margin="{TemplateBinding Padding}" Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}" Foreground="{TemplateBinding Foreground}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Top" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A group divider label in the side pane (store or games folder). -->
    <Style x:Key="PaneGroupLabel" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="CharacterSpacing" Value="40" />
    </Style>

    <!-- The back arrow in front of the page title in the window's title bar. -->
    <Style x:Key="TitleBackButton" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

</ResourceDictionary>
