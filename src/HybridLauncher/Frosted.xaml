<?xml version="1.0" encoding="utf-8"?>
<!-- The glass of the buttons laid over the game banner (links, the store chip, the launch bar), as Steam draws its library
     header: each button blurs what is behind it under a light smoky tint (GlassBrush: Hybrid Launcher's own, so it stays glass with
     Windows' transparency effects off), and its edge is where the blur stops: no outline, no hard line. Lighter on hover,
     darker when pressed. They are the buttons' own resource keys, merged into the banner's resources (WinUI styles cannot
     carry resources), so every state stays smooth and one place sets the look. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:HybridLauncher.Helpers">

    <helpers:GlassBrush x:Key="ButtonBackground" Tint="#943A3D46" Blur="18" />
    <helpers:GlassBrush x:Key="ButtonBackgroundPointerOver" Tint="#AD4E525D" Blur="18" />
    <helpers:GlassBrush x:Key="ButtonBackgroundPressed" Tint="#B31D1F24" Blur="18" />
    <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="#40FFFFFF" />
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#00FFFFFF" />
    <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#00FFFFFF" />
    <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#00FFFFFF" />
    <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="#00FFFFFF" />
    <SolidColorBrush x:Key="ButtonForeground" Color="White" />
    <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
    <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#E6FFFFFF" />
    <SolidColorBrush x:Key="ButtonForegroundDisabled" Color="#66FFFFFF" />

    <!-- The toggle (HDR): the same, and on it takes the accent. -->
    <helpers:GlassBrush x:Key="ToggleButtonBackground" Tint="#943A3D46" Blur="18" />
    <helpers:GlassBrush x:Key="ToggleButtonBackgroundPointerOver" Tint="#AD4E525D" Blur="18" />
    <helpers:GlassBrush x:Key="ToggleButtonBackgroundPressed" Tint="#B31D1F24" Blur="18" />
    <SolidColorBrush x:Key="ToggleButtonBackgroundDisabled" Color="#0CFFFFFF" />
    <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="{ThemeResource SystemAccentColor}" Opacity="0.32" />
    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="{ThemeResource SystemAccentColor}" Opacity="0.42" />
    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="{ThemeResource SystemAccentColor}" Opacity="0.22" />
    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedDisabled" Color="{ThemeResource SystemAccentColor}" Opacity="0.12" />
    <SolidColorBrush x:Key="ToggleButtonBorderBrush" Color="#00FFFFFF" />
    <SolidColorBrush x:Key="ToggleButtonBorderBrushPointerOver" Color="#00FFFFFF" />
    <SolidColorBrush x:Key="ToggleButtonBorderBrushPressed" Color="#00FFFFFF" />
    <SolidColorBrush x:Key="ToggleButtonBorderBrushDisabled" Color="#00FFFFFF" />
    <SolidColorBrush x:Key="ToggleButtonBorderBrushChecked" Color="#00FFFFFF" />
    <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPointerOver" Color="#00FFFFFF" />
    <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedPressed" Color="#00FFFFFF" />
    <SolidColorBrush x:Key="ToggleButtonBorderBrushCheckedDisabled" Color="#00FFFFFF" />
    <SolidColorBrush x:Key="ToggleButtonForeground" Color="White" />
    <SolidColorBrush x:Key="ToggleButtonForegroundPointerOver" Color="White" />
    <SolidColorBrush x:Key="ToggleButtonForegroundPressed" Color="#E6FFFFFF" />
    <SolidColorBrush x:Key="ToggleButtonForegroundDisabled" Color="#66FFFFFF" />
    <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="White" />
    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="White" />
    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#E6FFFFFF" />
    <SolidColorBrush x:Key="ToggleButtonForegroundCheckedDisabled" Color="#66FFFFFF" />
</ResourceDictionary>
