<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HybridLauncher.Views.GamePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:helpers="using:HybridLauncher.Helpers"
    xmlns:controls="using:HybridLauncher.Controls">

    <Grid>
    <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled" ViewChanged="Scroller_ViewChanged">
        <Grid x:Name="PageLayers">
        <!-- Under the banner a "floor" continues the art as a soft mirror that fades into the page, so the banner and the bar
             read as one surface. A layer of its own behind the page (a canvas never clips it), placed under the banner in code. -->
        <Canvas x:Name="FloorLayer" IsHitTestVisible="False">
            <Grid x:Name="Floor" Height="170">
                <!-- The bottom of the art flipped, blurred and fading out downwards (Helpers/FloorMirror). -->
                <Image x:Name="FloorImage" Stretch="Fill" />
                <!-- The art's dark bottom edge, carried on and fading to nothing: no colour of its own, so it meets any page. -->
                <Rectangle x:Name="FloorShade">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#D8000000" Offset="0" />
                            <GradientStop Color="#A0000000" Offset="0.35" />
                            <GradientStop Color="#00000000" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
            </Grid>
        </Canvas>
        <StackPanel x:Name="Root" MaxWidth="2600" Padding="20,4,20,32" Spacing="12">

            <!-- 1. Banner: the art, the game's title logo and overview, with the launch bar laid over its bottom edge. -->
            <!-- Full bleed: the art meets the game list along one hairline (the page's side padding is for the content below). -->
            <Grid x:Name="Hero" Height="380" Margin="-20,-4,-20,0">
                <Grid.Resources>
                    <ResourceDictionary>
                        <ResourceDictionary.MergedDictionaries>
                            <ResourceDictionary Source="ms-appx:///Frosted.xaml" />
                        </ResourceDictionary.MergedDictionaries>
                    </ResourceDictionary>
                </Grid.Resources>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!-- The art and its shades, under the whole banner (the bar included); the floor starts at its bottom edge. -->
                <Grid x:Name="ArtLayers" Grid.RowSpan="2">
                <Rectangle Fill="{StaticResource NeonBrush}" Opacity="0.55" />
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#C0100A24" Offset="0" />
                            <GradientStop Color="#E0050510" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Image x:Name="HeroImage" Stretch="UniformToFill" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" />
                <!-- The art at full brightness, as on Steam: no shade over the top or the middle, only a fade at the bottom
                     where the launch bar sits (it starts at 62%, so most of the art stays untouched). -->
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0.62" />
                            <GradientStop Color="#55000000" Offset="0.82" />
                            <GradientStop Color="#B0000000" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <!-- A light shade only along the bottom-left corner, under the store tags and the logo's foot, for bright art. -->
                <Rectangle>
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,1" EndPoint="0.55,0.45">
                            <GradientStop Color="#4D000000" Offset="0" />
                            <GradientStop Color="#00000000" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                </Grid>

                <!-- Links: one look for all of them (brand icon + label). Hovering their corner shows an eye that hides them all
                     (and brings them back); a right click hides one. The corner keeps a hover area even when they are hidden. -->
                <Grid x:Name="LinkArea" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="16,16,16,24" MinWidth="220" MinHeight="96"
                      Background="Transparent" ColumnSpacing="10" PointerEntered="LinkArea_PointerEntered" PointerExited="LinkArea_PointerExited" PointerCanceled="LinkArea_PointerExited">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="LinksToggle" Style="{StaticResource BannerButton}" Padding="10,9" VerticalAlignment="Top" Opacity="0" Click="LinksToggle_Click"
                        ToolTipService.ToolTip="Hide the links">
                    <Button.OpacityTransition>
                        <ScalarTransition Duration="0:0:0.15" />
                    </Button.OpacityTransition>
                    <FontIcon x:Name="LinksToggleIcon" Glyph="&#xED1A;" FontSize="16" />
                </Button>
                <StackPanel x:Name="LinkPills" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Spacing="10">
                    <Button x:Name="NexusButton" Style="{StaticResource BannerButton}" Click="Nexus_Click" ToolTipService.ToolTip="Open this game's page on Nexus Mods">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Image x:Name="NexusIcon" Source="ms-appx:///Assets/Brands/NexusMods.svg" Width="22" Height="22" VerticalAlignment="Center" />
                            <TextBlock x:Name="NexusLabel" Text="Nexus Mods" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="PcgwButton" Style="{StaticResource BannerButton}" Click="Pcgw_Click" ToolTipService.ToolTip="Open this game on PCGamingWiki">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Image x:Name="PcgwIcon" Source="ms-appx:///Assets/Brands/PCGamingWiki.png" Width="22" Height="22" VerticalAlignment="Center" />
                            <TextBlock x:Name="PcgwLabel" Text="PCGamingWiki" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="SteamDbButton" Style="{StaticResource BannerButton}" Click="SteamDb_Click" Visibility="Collapsed" ToolTipService.ToolTip="Open this game on SteamDB (depots, updates, player counts)">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Image x:Name="SteamDbIcon" Source="ms-appx:///Assets/Brands/SteamDB.svg" Width="22" Height="22" VerticalAlignment="Center" />
                            <TextBlock x:Name="SteamDbLabel" Text="SteamDB" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="OptiWikiButton" Style="{StaticResource BannerButton}" Click="OptiWiki_Click" ToolTipService.ToolTip="Open this game's page on the OptiScaler wiki (compatibility and setup notes)">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <!-- OptiScaler's own wordmark (the project has no other logo), then "Wiki". -->
                            <Image Source="ms-appx:///Assets/Brands/OptiScaler.png" Height="16" Stretch="Uniform" VerticalAlignment="Center" />
                            <TextBlock x:Name="OptiWikiLabel" Text="Wiki" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                </Grid>

                <StackPanel VerticalAlignment="Bottom" Margin="24,0,24,16" Spacing="6">
                    <!-- The game's title logo, Steam library style; the plain title stays as the fallback. -->
                    <Image x:Name="LogoImage" HorizontalAlignment="Left" Stretch="Uniform" MaxWidth="480" MaxHeight="150" Visibility="Collapsed" Margin="0,0,0,6" ToolTipService.ToolTip="{x:Null}" />
                    <TextBlock x:Name="TitleText" Foreground="White" Style="{StaticResource TitleLargeTextBlockStyle}" MaxLines="2" TextWrapping="Wrap" ToolTipService.ToolTip="{x:Null}" />
                    <StackPanel x:Name="BannerTags" Orientation="Horizontal" Spacing="10">
                        <!-- Store (opens the game in its store / launcher), then the graphics API, then developer and date. -->
                        <Button x:Name="StoreButton" Style="{StaticResource BannerChip}" Click="Store_Click">
                            <StackPanel x:Name="StoreBadgePanel" Orientation="Horizontal" Spacing="6">
                                <TextBlock x:Name="StoreText" FontWeight="SemiBold" FontSize="12" CharacterSpacing="80" VerticalAlignment="Center" TextLineBounds="Tight" />
                                <FontIcon Glyph="&#xE8A7;" FontSize="10" Opacity="0.7" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Border x:Name="ApiBadge" BorderThickness="0" CornerRadius="4" Padding="7,4" VerticalAlignment="Center" Visibility="Collapsed">
                            <Border.Background><helpers:GlassBrush Tint="#A6141519" Blur="16" /></Border.Background>
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon x:Name="ApiIcon" Glyph="&#xE7F4;" FontSize="10" VerticalAlignment="Center" Foreground="White" />
                                <TextBlock x:Name="ApiText" Foreground="White" FontWeight="Bold" FontSize="12" CharacterSpacing="80" VerticalAlignment="Center" TextLineBounds="Tight" />
                            </StackPanel>
                        </Border>
                        <!-- Upscalers and frame generation the game supports (PCGamingWiki), filled from code. -->
                        <StackPanel x:Name="TechBadges" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" Visibility="Collapsed" Background="Transparent" />
                        <TextBlock x:Name="MetaText" Foreground="#CCFFFFFF" Style="{StaticResource CaptionTextBlockStyle}" CharacterSpacing="60" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>

                <!-- 2. Launch bar: the bottom of the art seen through dark frosted glass (strongly blurred, so white text keeps its
                     contrast on any art), as in Steam's library; always dark. Minimal like Steam and Hydra: its buttons are light
                     see-through faces (see LaunchGrid's resources) and the play stats sit on the glass itself. -->
                <Border x:Name="LaunchBar" Grid.Row="1" RequestedTheme="Dark" Padding="20,12,20,10">
                    <Border.Background>
                        <helpers:GlassBrush Tint="#7A0A0B0E" Blur="40" />
                    </Border.Background>
                    <StackPanel Spacing="6">
                        <!-- Every item takes only the room it needs; the free space sits between the arguments and the buttons on the right. -->
                        <Grid x:Name="LaunchGrid" ColumnSpacing="10" RowSpacing="10">
                            <!-- The bar's buttons, a blend of Hybrid's glass, Hydra's pills and Steam's light fills: a see-through white face,
                                 a touch lighter at the top so it reads as a button, no outline; brighter on hover, darker when pressed.
                                 Plain fills (no blur to redraw while scrolling). Last played and Play time stay unboxed, as on Steam. -->
                            <Grid.Resources>
                                <LinearGradientBrush x:Key="ButtonBackground" StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#2EFFFFFF" Offset="0" />
                                    <GradientStop Color="#1AFFFFFF" Offset="1" />
                                </LinearGradientBrush>
                                <LinearGradientBrush x:Key="ButtonBackgroundPointerOver" StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#45FFFFFF" Offset="0" />
                                    <GradientStop Color="#2BFFFFFF" Offset="1" />
                                </LinearGradientBrush>
                                <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#14FFFFFF" />
                                <LinearGradientBrush x:Key="ToggleButtonBackground" StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#2EFFFFFF" Offset="0" />
                                    <GradientStop Color="#1AFFFFFF" Offset="1" />
                                </LinearGradientBrush>
                                <LinearGradientBrush x:Key="ToggleButtonBackgroundPointerOver" StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Color="#45FFFFFF" Offset="0" />
                                    <GradientStop Color="#2BFFFFFF" Offset="1" />
                                </LinearGradientBrush>
                                <SolidColorBrush x:Key="ToggleButtonBackgroundPressed" Color="#14FFFFFF" />
                            </Grid.Resources>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Play, then Stop while the game runs (drawn by the control itself: gradient, glow, spring). -->
                            <controls:PlayButton x:Name="PlayButton" VerticalAlignment="Stretch" />

                            <!-- Steam library style: last session and time played. -->
                            <StackPanel x:Name="PlayStatsPanel" Grid.Column="1" Orientation="Horizontal" Spacing="24" Margin="14,0,10,0" VerticalAlignment="Center" Background="Transparent">
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE787;" FontSize="20" Opacity="0.55" VerticalAlignment="Center" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="LAST PLAYED" FontSize="11" FontWeight="SemiBold" CharacterSpacing="80" Opacity="0.62" />
                                        <TextBlock x:Name="LastPlayedText" FontSize="15" FontWeight="SemiBold" Foreground="White" Text="—" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                    <FontIcon Glyph="&#xE823;" FontSize="20" Opacity="0.55" VerticalAlignment="Center" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="PLAY TIME" FontSize="11" FontWeight="SemiBold" CharacterSpacing="80" Opacity="0.62" />
                                        <TextBlock x:Name="PlayTimeText" FontSize="15" FontWeight="SemiBold" Foreground="White" Text="—" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>

                            <!-- Not on this PC yet: the download's progress, Steam style (filled from code, in place of the play stats). -->
                            <Grid x:Name="DownloadPanel" Grid.Column="1" Width="380" Margin="6,0,6,0" VerticalAlignment="Center" RowSpacing="5" Visibility="Collapsed" Background="Transparent">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="DownloadStateText" FontSize="10" FontWeight="SemiBold" CharacterSpacing="60" Opacity="0.75" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="DownloadSpeedText" Grid.Column="1" FontSize="12" FontWeight="SemiBold" />
                                </Grid>
                                <Grid Grid.Row="1" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ProgressBar x:Name="DownloadBar" Maximum="1" MinHeight="6" VerticalAlignment="Center" />
                                    <!-- Hybrid Launcher's own downloads: pause and resume here, as in Steam's library. -->
                                    <Button x:Name="DownloadPauseButton" Grid.Column="1" Style="{StaticResource IconButton}" Width="28" Height="28" Padding="0" Visibility="Collapsed" Click="DownloadPause_Click">
                                        <FontIcon x:Name="DownloadPauseGlyph" FontSize="12" />
                                    </Button>
                                </Grid>
                                <TextBlock x:Name="DownloadDetailText" Grid.Row="2" FontSize="12" Opacity="0.75" TextTrimming="CharacterEllipsis" />
                            </Grid>

                            <!-- Smart HDR for this game: Windows HDR on while it runs, off again when it closes. -->
                            <StackPanel x:Name="LaunchToggles" Grid.Column="2" Orientation="Horizontal" Spacing="10">
                                <ToggleButton x:Name="HdrToggle" Style="{StaticResource GlassToggleButton}" VerticalAlignment="Stretch" Padding="12,4" Click="HdrToggle_Click">
                                    <!-- Checked keeps the bar's look (no accent fill, no rim): the lit sun shows the state. -->
                                    <ToggleButton.Resources>
                                        <LinearGradientBrush x:Key="ToggleButtonBackgroundChecked" StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#2EFFFFFF" Offset="0" />
                                            <GradientStop Color="#1AFFFFFF" Offset="1" />
                                        </LinearGradientBrush>
                                        <LinearGradientBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Color="#45FFFFFF" Offset="0" />
                                            <GradientStop Color="#2BFFFFFF" Offset="1" />
                                        </LinearGradientBrush>
                                        <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="#14FFFFFF" />
                                        <SolidColorBrush x:Key="ToggleButtonForegroundChecked" Color="White" />
                                        <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPointerOver" Color="White" />
                                        <SolidColorBrush x:Key="ToggleButtonForegroundCheckedPressed" Color="#CCFFFFFF" />
                                    </ToggleButton.Resources>
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <!-- The sun in a round plate: lit amber-to-pink while Smart HDR is on, a quiet outline while off. -->
                                        <Border x:Name="HdrIcon" Width="30" Height="30" CornerRadius="15" BorderThickness="0" VerticalAlignment="Center">
                                            <FontIcon x:Name="HdrGlyph" Glyph="&#xE706;" FontSize="15" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="HDR" FontWeight="Bold" FontSize="13" CharacterSpacing="60" />
                                            <TextBlock x:Name="HdrToggleState" FontSize="11" Opacity="0.75" Text="Off" />
                                        </StackPanel>
                                    </StackPanel>
                                </ToggleButton>
                                <!-- Cloud saves for this game: its state at a glance, the menu (sync now, older copies, folder) on click. -->
                                <Button x:Name="CloudButton" Style="{StaticResource GlassButton}" VerticalAlignment="Stretch" Padding="12,4" Click="CloudButton_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Grid Width="30" Height="30" VerticalAlignment="Center">
                                            <Border x:Name="CloudIcon" CornerRadius="15" BorderThickness="0">
                                                <FontIcon x:Name="CloudGlyph" Glyph="&#xE753;" FontSize="15" />
                                            </Border>
                                            <ProgressRing x:Name="CloudRing" Width="30" Height="30" IsActive="False" Visibility="Collapsed" Foreground="#FF4FC3F7" />
                                        </Grid>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="Cloud" FontWeight="Bold" FontSize="13" CharacterSpacing="40" />
                                            <TextBlock x:Name="CloudStateText" FontSize="11" Opacity="0.75" Text="Off" />
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <!-- Compact while idle; once focused it spans to the right edge, over the buttons, and wraps so every argument shows. -->
                            <TextBox x:Name="ArgsBox" Grid.Column="3" Visibility="Collapsed" VerticalAlignment="Center" HorizontalAlignment="Left" MinWidth="150" MaxWidth="240"
                                     Background="#26FFFFFF" BorderBrush="Transparent" Canvas.ZIndex="10"
                                     PlaceholderText="Launch arguments" ToolTipService.ToolTip="Launch arguments, e.g. -dx12 -skipintro. Enter starts the game. (The gear: General)"
                                     GotFocus="ArgsBox_GotFocus" LostFocus="ArgsBox_LostFocus" KeyDown="ArgsBox_KeyDown" />
                            <StackPanel x:Name="FolderGroup" Grid.Column="5" Orientation="Horizontal" Spacing="10">
                            <Button x:Name="FolderButton" Style="{StaticResource GlassButton}" Click="OpenFolder_Click" Padding="12,3" VerticalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon x:Name="FolderIcon" Glyph="&#xE838;" FontSize="16" Foreground="#FFFFC857" VerticalAlignment="Center" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="FolderLabel" Text="Open game folder" />
                                        <!-- The install folder's size on disk, measured in the background. -->
                                        <TextBlock x:Name="SizeText" FontSize="11" FontWeight="Normal" Opacity="0.7" Text="Measuring…" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                            <!-- The game's settings and save folders, from PCGamingWiki; shown only when they exist on this PC. -->
                            <Button x:Name="SaveFolderButton" Style="{StaticResource GlassButton}" Padding="12,3" VerticalAlignment="Stretch" Click="SaveFolder_Click" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon x:Name="SaveIcon" Glyph="&#xE74E;" FontSize="16" Foreground="#FF6CB8FF" VerticalAlignment="Center" />
                                    <StackPanel x:Name="SaveFolderLabel" VerticalAlignment="Center">
                                        <TextBlock Text="Open saves folder" />
                                        <TextBlock x:Name="SaveSizeText" FontSize="11" FontWeight="Normal" Opacity="0.7" Text="Measuring…" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                            <Button x:Name="ConfigFolderButton" Style="{StaticResource GlassButton}" Padding="12,3" VerticalAlignment="Stretch" Click="ConfigFolder_Click" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon x:Name="ConfigIcon" Glyph="&#xE90F;" FontSize="16" Foreground="#FFB9A3FF" VerticalAlignment="Center" />
                                    <StackPanel x:Name="ConfigFolderLabel" VerticalAlignment="Center">
                                        <TextBlock Text="Open configuration folder" />
                                        <TextBlock x:Name="ConfigSizeText" FontSize="11" FontWeight="Normal" Opacity="0.7" Text="Measuring…" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                            </StackPanel>
                            <Button x:Name="AchButton" Grid.Column="6" Style="{StaticResource GlassButton}" VerticalAlignment="Stretch" Click="AchButton_Click" Visibility="Collapsed" ToolTipService.ToolTip="Steam achievements">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <!-- Hybrid Launcher's trophy (Icons.TrophyPath, set in code), scaled to the slot and centred in it. -->
                                    <ContentControl x:Name="AchIcon" Width="20" Height="20" IsTabStop="False" Foreground="#FFFFD34D" VerticalAlignment="Center"
                                                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                                    <TextBlock x:Name="AchButtonText" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="PinButton" Grid.Column="7" Style="{StaticResource GlassButton}" MinWidth="46" Padding="0" VerticalAlignment="Stretch" Click="Pin_Click">
                                <FontIcon x:Name="PinIcon" Glyph="&#xE718;" FontSize="16" VerticalAlignment="Center" />
                            </Button>
                            <!-- The game's properties, Steam style: a window over the page with General, Installed files, Library and Customization (GamePage.Menu.cs). -->
                            <Button x:Name="MoreButton" Grid.Column="8" Style="{StaticResource GlassButton}" MinWidth="46" Padding="0" VerticalAlignment="Stretch" ToolTipService.ToolTip="Game settings" Click="MoreButton_Click">
                                <FontIcon Glyph="&#xE713;" FontSize="17" VerticalAlignment="Center" />
                            </Button>
                        </Grid>
                        <TextBlock x:Name="ExeLine" Foreground="#B3FFFFFF" FontSize="12" IsTextSelectionEnabled="True" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- 3. The tab row (built in code: order, hidden tabs and drag to reorder come from the settings). While the page
                 scrolls past it, the row moves into StickyBar at the top of the page, so the open tab always shows. -->
            <Border x:Name="TabHost" Margin="0,2,0,0">
                <controls:TabStrip x:Name="Tabs" />
            </Border>

            <!-- 3o. Game, OptiScaler wiki and PCGamingWiki: built in code the first time they are shown. -->
            <Border x:Name="OverviewHost" Visibility="Collapsed" />
            <Border x:Name="PcgwHost" Visibility="Collapsed" />
            <Border x:Name="LinksHost" Visibility="Collapsed" />
            <Border x:Name="ReShadeHost" Visibility="Collapsed" />
            <Border x:Name="RenoDxHost" Visibility="Collapsed" />
            <Border x:Name="LumaHost" Visibility="Collapsed" />
            <Border x:Name="QuickHost" Visibility="Collapsed" />
            <Border x:Name="NotesHost" Visibility="Collapsed" />
            <!-- Tabs that work on the game's files, on the page of a game not installed yet: what they do, and Download. -->
            <Border x:Name="OfflineHost" Visibility="Collapsed" />

            <!-- 3a. OptiScaler: a guided install (version, options, install) beside the ASI plugins; stacked on small windows. -->
            <Grid x:Name="OptiTab" ColumnSpacing="12" RowSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="360" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel x:Name="OptiMain" Spacing="12" VerticalAlignment="Top">
                <Border x:Name="OptiCard" Style="{StaticResource CardStyle}" VerticalAlignment="Top" Padding="0">
                    <StackPanel>
                        <!-- Status: one look at the top says what is in the game folder now. Tinted by state from code. -->
                        <Grid x:Name="OptiHeader" Padding="20,16" ColumnSpacing="14" CornerRadius="8,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="StatusIconCircle" Width="44" Height="44" CornerRadius="22" VerticalAlignment="Top">
                                <FontIcon x:Name="StatusIcon" Glyph="&#xE896;" FontSize="20" Foreground="White" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock x:Name="OptiHeadline" Text="OptiScaler" Style="{StaticResource SectionTitle}" TextWrapping="Wrap" />
                                <TextBlock x:Name="OptiStatusDetail" Style="{StaticResource RowDescription}" IsTextSelectionEnabled="True" />
                                <!-- Disk space of every OptiScaler file in the game folder, logs included; kept up to date while the tab is open. -->
                                <StackPanel x:Name="OptiFilesPanel" Orientation="Horizontal" Spacing="6" Visibility="Collapsed" Background="Transparent">
                                    <FontIcon Glyph="&#xEDA2;" FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="OptiFilesText" Style="{StaticResource RowDescription}" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                            <Border x:Name="StatusPill" Grid.Column="2" VerticalAlignment="Top" CornerRadius="12" Padding="12,4">
                                <TextBlock x:Name="StatusPillText" Style="{StaticResource CaptionTextBlockStyle}" FontWeight="SemiBold" />
                            </Border>
                        </Grid>
                        <Rectangle Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />

                        <StackPanel Padding="20,16,20,20" Spacing="22">
                            <!-- Step 1: the version. -->
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <controls:StepBadge Number="1" />
                                    <TextBlock Text="Choose a version" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Spacing="10" Margin="38,0,0,0">
                                    <Grid x:Name="ChannelCards" ColumnSpacing="8" RowSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <RadioButton x:Name="StableCard" GroupName="OptiChannel" Tag="Stable" Style="{StaticResource ChoiceCard}" Checked="Channel_Checked">
                                            <StackPanel Spacing="2">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE930;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                    <TextBlock Text="Stable" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                </StackPanel>
                                                <TextBlock Text="Tested releases." Style="{StaticResource RowDescription}" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton x:Name="NightlyCard" Grid.Column="1" GroupName="OptiChannel" Tag="Nightly" Style="{StaticResource ChoiceCard}" Checked="Channel_Checked">
                                            <StackPanel Spacing="2">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE708;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                    <TextBlock Text="Nightly" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                </StackPanel>
                                                <TextBlock Text="Newest features, built daily." Style="{StaticResource RowDescription}" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton x:Name="CustomCard" Grid.Column="2" GroupName="OptiChannel" Tag="Custom" Style="{StaticResource ChoiceCard}" Checked="Channel_Checked">
                                            <StackPanel Spacing="2">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE90F;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                                    <TextBlock Text="Custom build" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                </StackPanel>
                                                <TextBlock Text="Builds you imported (e.g. Discord)." Style="{StaticResource RowDescription}" />
                                            </StackPanel>
                                        </RadioButton>
                                    </Grid>
                                    <Grid x:Name="VersionGrid" ColumnSpacing="8" RowSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <ComboBox x:Name="VersionCombo" HorizontalAlignment="Stretch" VerticalAlignment="Center" MinWidth="200"
                                                  PlaceholderText="Loading versions…" SelectionChanged="VersionCombo_SelectionChanged" />
                                        <StackPanel x:Name="ChannelTools" Grid.Column="1" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                            <HyperlinkButton x:Name="ReleasesLink" Content="Release notes" Click="Releases_Click" />
                                            <Button x:Name="ImportBuildButton" Padding="10,5" ToolTipService.ToolTip="Import a build (e.g. one shared on Discord)">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <FontIcon Glyph="&#xE8B5;" FontSize="13" />
                                                    <TextBlock Text="Import" />
                                                </StackPanel>
                                                <Button.Flyout>
                                                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                        <MenuFlyoutItem Text="From a folder…" Click="ImportFolder_Click">
                                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B7;" /></MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem Text="From an archive (.zip, .7z, .rar)…" Click="ImportArchive_Click">
                                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xF012;" /></MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                    </MenuFlyout>
                                                </Button.Flyout>
                                            </Button>
                                            <Button x:Name="CustomMoreButton" Padding="10,5" ToolTipService.ToolTip="More">
                                                <FontIcon Glyph="&#xE712;" FontSize="13" />
                                                <Button.Flyout>
                                                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                                                        <MenuFlyoutItem Text="Open the custom builds folder" Click="CustomFolder_Click">
                                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE838;" /></MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem Text="Refresh" Click="CustomRefresh_Click">
                                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72C;" /></MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                        <MenuFlyoutItem x:Name="RemoveBuildItem" Text="Delete selected build" Click="RemoveBuild_Click">
                                                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                                                        </MenuFlyoutItem>
                                                    </MenuFlyout>
                                                </Button.Flyout>
                                            </Button>
                                        </StackPanel>
                                        <TextBlock x:Name="ChannelHint" Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource RowDescription}" IsTextSelectionEnabled="True" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>

                            <!-- Step 2: the answers given to the setup script. -->
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <controls:StepBadge Number="2" />
                                    <TextBlock Text="Setup options" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                                </StackPanel>
                                <Expander x:Name="SetupExpander" Margin="38,0,0,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsExpanded="False">
                                    <Expander.Header>
                                        <Grid Padding="0,8" ColumnSpacing="12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Glyph="&#xE9E9;" FontSize="16" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Answers for setup_windows.bat (the defaults suit most games)" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" />
                                                <TextBlock x:Name="SetupSummary" Style="{StaticResource RowDescription}" />
                                            </StackPanel>
                                        </Grid>
                                    </Expander.Header>
                                    <StackPanel Spacing="4">
                                        <TextBlock Style="{StaticResource RowDescription}" Margin="0,0,0,6"
                                                   Text="OptiScaler is always installed by its own setup_windows.bat. Install runs it silently with these answers, saved for this game; Standard .bat install lets you answer it yourself." />
                                        <StackPanel x:Name="AnswerRows" Spacing="4">
                                        <Border Style="{StaticResource RowStyle}">
                                            <Grid ColumnSpacing="16">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="OptiScaler file name" Style="{StaticResource RowHeader}" />
                                                    <TextBlock Text="dxgi.dll works for most games. Vulkan: winmm.dll. Xbox / Game Pass: winmm.dll or version.dll." Style="{StaticResource RowDescription}" />
                                                </StackPanel>
                                                <ComboBox x:Name="DllCombo" Grid.Column="1" MinWidth="170" VerticalAlignment="Center" SelectionChanged="SetupChanged" />
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource RowStyle}">
                                            <Grid ColumnSpacing="16">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Graphics card" Style="{StaticResource RowHeader}" />
                                                    <TextBlock x:Name="GpuHint" Style="{StaticResource RowDescription}" />
                                                </StackPanel>
                                                <ComboBox x:Name="GpuCombo" Grid.Column="1" MinWidth="170" VerticalAlignment="Center" SelectionChanged="SetupChanged">
                                                    <x:String>Auto-detect</x:String>
                                                    <x:String>AMD / Intel</x:String>
                                                    <x:String>Nvidia</x:String>
                                                </ComboBox>
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource RowStyle}">
                                            <Grid ColumnSpacing="16">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Nvidia spoofing (use DLSS inputs)" Style="{StaticResource RowHeader}" />
                                                    <TextBlock Text="Needed to replace DLSS with FSR / XeSS, for DLSS-FG and for Reflex → Anti-Lag 2. Asked only on AMD / Intel." Style="{StaticResource RowDescription}" />
                                                </StackPanel>
                                                <ToggleSwitch x:Name="SpoofToggle" Grid.Column="1" OnContent="On" OffContent="Off" MinWidth="0" Toggled="SetupChanged" />
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource RowStyle}">
                                            <Grid ColumnSpacing="16">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="OptiPatcher" Style="{StaticResource RowHeader}" />
                                                    <TextBlock x:Name="OptiPatcherHint" Style="{StaticResource RowDescription}" Text="Unlocks DLSS / DLSS-FG inputs without spoofing in supported games. Asked only on AMD / Intel." />
                                                </StackPanel>
                                                <ToggleSwitch x:Name="OptiPatcherToggle" Grid.Column="1" OnContent="On" OffContent="Off" MinWidth="0" Toggled="SetupChanged" />
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource RowStyle}">
                                            <Grid ColumnSpacing="16">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="Delete old OptiScaler leftovers" Style="{StaticResource RowHeader}" />
                                                    <TextBlock Text="nvngx.dll, nvapi64.dll, OptiScaler.asi and older OptiScaler dlls. Hybrid Launcher backs them up first and restores them on uninstall." Style="{StaticResource RowDescription}" />
                                                </StackPanel>
                                                <ToggleSwitch x:Name="OldFilesToggle" Grid.Column="1" OnContent="On" OffContent="Off" MinWidth="0" Toggled="SetupChanged" />
                                            </Grid>
                                        </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>

                            <!-- Step 3: install (silent or with the bat window), and what to do once installed. -->
                            <StackPanel Spacing="10">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <controls:StepBadge Number="3" />
                                    <TextBlock x:Name="Step3Title" Text="Install" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                                </StackPanel>
                                <Border Margin="38,0,0,0" Style="{StaticResource RowStyle}" Padding="14,12">
                                    <StackPanel Spacing="10">
                                        <Grid x:Name="ActionRow" ColumnSpacing="8" RowSpacing="8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Button x:Name="InstallButton" Style="{StaticResource AccentButtonStyle}" Padding="20,8" Click="Install_Click"
                                                    ToolTipService.ToolTip="Runs setup_windows.bat silently with the setup options above">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE896;" FontSize="15" />
                                                    <TextBlock x:Name="InstallButtonText" Text="Install OptiScaler" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="BatInstallButton" Grid.Column="1" Padding="14,8" Click="BatInstall_Click"
                                                    ToolTipService.ToolTip="Standard .bat install: Hybrid Launcher copies the files and backs up the folder as usual, then opens setup_windows.bat in its own window so you answer it yourself. Uninstall still puts everything back.">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE756;" FontSize="14" />
                                                    <TextBlock Text="Standard .bat install" />
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="OpenIniButton" Grid.Column="3" Padding="14,8" Click="OpenIni_Click" ToolTipService.ToolTip="Choose an app and open OptiScaler.ini with it">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE8A5;" FontSize="14" />
                                                    <TextBlock Text="Open OptiScaler.ini" />
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="UninstallButton" Grid.Column="4" Padding="14,8" Click="Uninstall_Click">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <FontIcon Glyph="&#xE74D;" FontSize="14" />
                                                    <TextBlock Text="Uninstall" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                        <!-- What Install will do: the whole text, wrapped; the chevron folds it to one line (remembered). -->
                                        <Grid x:Name="InstallHintPanel" ColumnSpacing="8" Background="Transparent">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Glyph="&#xE946;" FontSize="13" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Top" Margin="0,2,0,0" />
                                            <TextBlock x:Name="InstallHint" Grid.Column="1" Style="{StaticResource RowDescription}" TextWrapping="Wrap" />
                                            <Button x:Name="InstallHintFold" Grid.Column="2" Style="{StaticResource IconButton}" VerticalAlignment="Top" Margin="0,-6,0,0" Click="InstallHintFold_Click" />
                                        </Grid>

                                        <StackPanel x:Name="ProgressPanel" Spacing="6" Visibility="Collapsed">
                                            <Grid ColumnSpacing="12">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <TextBlock x:Name="ProgressStage" Style="{StaticResource BodyTextBlockStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <Button x:Name="CancelButton" Grid.Column="1" Content="Cancel" Click="Cancel_Click" />
                                            </Grid>
                                            <ProgressBar x:Name="InstallProgressBar" Maximum="1" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- The keys OptiScaler listens to in game, each set by pressing it (filled from OptiScaler.ini). -->
                                <StackPanel x:Name="KeysPanel" Margin="38,4,0,0" Spacing="6" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE92E;" FontSize="14" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="In-game keys" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                                        <TextBlock Text="Click a key, then press the one you want." Style="{StaticResource RowDescription}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel x:Name="KeysRows" Spacing="4" />
                                </StackPanel>

                                <Expander x:Name="LogExpander" Margin="38,0,0,0" Header="Setup log" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Visibility="Collapsed">
                                    <ScrollViewer x:Name="LogScroller" MaxHeight="280" HorizontalScrollBarVisibility="Auto">
                                        <TextBlock x:Name="LogText" FontFamily="Cascadia Mono, Consolas" FontSize="12" IsTextSelectionEnabled="True" TextWrapping="NoWrap" />
                                    </ScrollViewer>
                                </Expander>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <!-- A preview of the game's OptiScaler wiki entry (built in code), with the way to its tab. -->
                <Border x:Name="OptiWikiPreviewHost" />
                </StackPanel>

                <StackPanel x:Name="SideColumn" Grid.Column="1" Spacing="12" VerticalAlignment="Top">
                <Border x:Name="AsiCard" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <Grid x:Name="AsiHeader" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel x:Name="AsiTitle" Spacing="2" VerticalAlignment="Center" Background="Transparent">
                                <TextBlock Text="ASI plugins" Style="{StaticResource SectionTitle}" />
                                <TextBlock x:Name="AsiSummary" Style="{StaticResource RowDescription}" />
                            </StackPanel>
                            <Button x:Name="AsiAddButton" Grid.Column="1" Style="{StaticResource IconButton}" Click="AsiAdd_Click" ToolTipService.ToolTip="Add .asi files (copied into the shared folder)">
                                <FontIcon Glyph="&#xE710;" FontSize="14" />
                            </Button>
                            <Button Grid.Column="2" Style="{StaticResource IconButton}" Click="AsiRefresh_Click" ToolTipService.ToolTip="Refresh">
                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            </Button>
                            <Button Grid.Column="3" Style="{StaticResource IconButton}" Click="AsiOpen_Click" ToolTipService.ToolTip="Open the shared ASI plugins folder">
                                <FontIcon Glyph="&#xE838;" FontSize="14" />
                            </Button>
                        </Grid>
                        <StackPanel x:Name="AsiBody" Spacing="10">
                        <TextBlock Style="{StaticResource RowDescription}"
                                   Text="Optional extras, kept in one shared folder. The switches are for this game only: a plugin turned on is copied into its OptiScaler install, and removed when turned off." />
                        <StackPanel x:Name="AsiList" Spacing="4" />
                        <HyperlinkButton x:Name="AsiEmpty" Click="AsiAdd_Click" Padding="0">
                            <TextBlock Text="No .asi files yet: add one" TextWrapping="Wrap" />
                        </HyperlinkButton>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Every OptiScaler version kept on this PC, each with a bin. -->
                <Border x:Name="VersionsCard" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="10">
                        <Grid x:Name="VersionsHeader" ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="VersionsTitle" Text="Saved versions" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Style="{StaticResource IconButton}" Click="VersionsRefresh_Click" ToolTipService.ToolTip="Refresh">
                                <FontIcon Glyph="&#xE72C;" FontSize="14" />
                            </Button>
                        </Grid>
                        <controls:SavedVersionsList x:Name="VersionsList" />
                    </StackPanel>
                </Border>

                <!-- The newest releases, previewed: Open goes to the Release notes section. -->
                <Border x:Name="OptiNotesPreviewHost" />

                <!-- Where OptiScaler lives: the project on GitHub and the test builds channel on its Discord. -->
                <Border x:Name="OptiLinksCard" Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="6">
                        <TextBlock Text="OptiScaler links" Style="{StaticResource SectionTitle}" />
                        <HyperlinkButton Click="OptiGithub_Click" Padding="0,4" ToolTipService.ToolTip="github.com/optiscaler/OptiScaler: releases, wiki, issues">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE943;" FontSize="15" />
                                <TextBlock Text="OptiScaler on GitHub" />
                            </StackPanel>
                        </HyperlinkButton>
                        <HyperlinkButton Click="OptiDiscord_Click" Padding="0,4" ToolTipService.ToolTip="Opens the test builds channel of the OptiScaler Discord in the Discord app">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE8BD;" FontSize="15" />
                                <TextBlock Text="Test builds (Discord)" />
                            </StackPanel>
                        </HyperlinkButton>
                    </StackPanel>
                </Border>
                </StackPanel>
            </Grid>

            <!-- 3a'. Quick Panel: the few OptiScaler.ini settings changed before almost every session (frame cap, frame generation,
                 ASI plugins), right under the install. Filled in code (GamePage.Ini.cs). -->
            <Border x:Name="QuickPanelCard" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                <StackPanel Spacing="10">
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Width="34" Height="34" CornerRadius="8" Background="#33F2B82E" VerticalAlignment="Center">
                            <FontIcon Glyph="&#xE945;" FontSize="16" Foreground="#FFF2B82E" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Quick Panel" Style="{StaticResource SectionTitle}" />
                            <TextBlock x:Name="QuickPanelHint" Style="{StaticResource RowDescription}" TextWrapping="Wrap"
                                       Text="Frame rate cap, frame generation and ASI plugins: the settings changed most, written straight to OptiScaler.ini." />
                        </StackPanel>
                        <!-- Customize: take settings out, add any other OptiScaler.ini setting (shared by every game). -->
                        <DropDownButton Grid.Column="2" VerticalAlignment="Center" Padding="12,6" ToolTipService.ToolTip="Choose which OptiScaler settings the Quick Panel shows">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE70F;" FontSize="13" />
                                <TextBlock Text="Customize" />
                            </StackPanel>
                            <DropDownButton.Flyout>
                                <Flyout x:Name="QuickCustomizeFlyout" Placement="BottomEdgeAlignedRight" Opening="QuickCustomize_Opening" />
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </Grid>
                    <!-- Which Quick Panel this is: this game's own, or the one every game shares (both can be viewed and changed). -->
                    <Grid ColumnSpacing="12" Padding="12,4,12,6" CornerRadius="8" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE71D;" FontSize="14" Opacity="0.75" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Profile" FontWeight="SemiBold" />
                            <TextBlock x:Name="QuickScopeText" Style="{StaticResource RowDescription}" TextWrapping="Wrap" />
                        </StackPanel>
                        <!-- Two profiles: this game's own panel, or the Global one every game shares. -->
                        <SelectorBar x:Name="QuickScopeBar" Grid.Column="2" VerticalAlignment="Center" SelectionChanged="QuickScope_Changed">
                            <SelectorBarItem x:Name="QuickScopeOwn" Text="This game only" Tag="own"
                                             ToolTipService.ToolTip="This game's own Quick Panel: what you add or remove stays with this game." />
                            <SelectorBarItem x:Name="QuickScopeGlobal" Text="Global" Tag="global"
                                             ToolTipService.ToolTip="The Global Quick Panel, shared by every game set to Global." />
                        </SelectorBar>
                    </Grid>
                    <Border x:Name="QuickPanelRows" />
                </StackPanel>
            </Border>

            <!-- 3b. OptiScaler.ini settings: essentials, before launch, changed and every section of the file, as cards of switches,
                 sliders and choices with plain names and descriptions. Built in code (GamePage.Ini.cs). -->
            <Border x:Name="IniCard" Style="{StaticResource CardStyle}" Visibility="Collapsed" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid x:Name="IniHeader" Padding="20,14,20,14" ColumnSpacing="10" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <TextBlock Text="OptiScaler settings" Style="{StaticResource SectionTitle}" VerticalAlignment="Center" />
                                <Border x:Name="ChangedPill" CornerRadius="10" Padding="9,1,9,2" VerticalAlignment="Center" Visibility="Collapsed"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}">
                                    <TextBlock x:Name="ChangedPillText" FontSize="12" FontWeight="SemiBold" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                </Border>
                            </StackPanel>
                            <TextBlock x:Name="IniPathText" Style="{StaticResource RowDescription}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" IsTextSelectionEnabled="True" />
                        </StackPanel>
                        <AutoSuggestBox x:Name="IniSearch" Grid.Column="1" Width="280" VerticalAlignment="Center" PlaceholderText="Search every setting" QueryIcon="Find" TextChanged="IniSearch_TextChanged" />
                        <!-- Saved sets of OptiScaler.ini values, shared by every game; the menu is built when it opens. -->
                        <DropDownButton x:Name="ProfilesButton" Grid.Column="2" VerticalAlignment="Center" Padding="12,5"
                                        ToolTipService.ToolTip="Profiles: save these OptiScaler.ini settings and apply them to any game">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE8F1;" FontSize="14" />
                                <TextBlock Text="Profiles" />
                            </StackPanel>
                            <DropDownButton.Flyout>
                                <MenuFlyout x:Name="ProfilesFlyout" Placement="BottomEdgeAlignedRight" Opening="ProfilesFlyout_Opening" />
                            </DropDownButton.Flyout>
                        </DropDownButton>
                        <!-- Back to OptiScaler.ini as the install left it. -->
                        <Button x:Name="RestoreDefaultsButton" Grid.Column="3" VerticalAlignment="Center" Padding="12,5" Click="RestoreDefaults_Click"
                                ToolTipService.ToolTip="Put every setting back to how OptiScaler.ini was right after the install">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE777;" FontSize="14" />
                                <TextBlock Text="Restore defaults" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Rectangle Grid.Row="1" Height="1" Fill="{ThemeResource CardStrokeColorDefaultBrush}" />

                    <TextBlock x:Name="IniUnavailable" Grid.Row="2" Margin="20,16,20,20" Style="{StaticResource BodyTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"
                               Text="Install OptiScaler to change its settings here. Changes are written to OptiScaler.ini and re-applied after every reinstall or update." />

                    <!-- Four views over the file; each shows its settings as cards (switches, sliders, segmented choices). -->
                    <StackPanel x:Name="IniBody" Grid.Row="2" Padding="20,14,20,22" Spacing="14" Visibility="Collapsed">
                        <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled" VerticalScrollBarVisibility="Disabled">
                            <SelectorBar x:Name="IniViewBar" SelectionChanged="IniViewBar_SelectionChanged">
                                <SelectorBarItem x:Name="IniEssentialsItem" Text="Essentials" Tag="essentials">
                                    <SelectorBarItem.Icon><FontIcon Glyph="&#xE734;" Foreground="#FFF2B82E" /></SelectorBarItem.Icon>
                                </SelectorBarItem>
                                <SelectorBarItem x:Name="IniRestartItem" Text="Before launch" Tag="restart">
                                    <SelectorBarItem.Icon><FontIcon Glyph="&#xE7E8;" Foreground="#FFF07F2A" /></SelectorBarItem.Icon>
                                </SelectorBarItem>
                                <SelectorBarItem x:Name="IniChangedItem" Text="Changed" Tag="changed">
                                    <SelectorBarItem.Icon><FontIcon Glyph="&#xE70F;" Foreground="#FF3D9BFF" /></SelectorBarItem.Icon>
                                </SelectorBarItem>
                                <SelectorBarItem x:Name="IniAllItem" Text="All sections" Tag="all">
                                    <SelectorBarItem.Icon><FontIcon Glyph="&#xE8FD;" Foreground="#FF8B94A8" /></SelectorBarItem.Icon>
                                </SelectorBarItem>
                            </SelectorBar>
                        </ScrollViewer>
                        <StackPanel Spacing="2">
                            <TextBlock x:Name="IniPaneTitle" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="18" />
                            <TextBlock x:Name="IniPaneHint" Style="{StaticResource RowDescription}" />
                        </StackPanel>
                        <!-- With "Before launch": why these settings are grouped apart. -->
                        <Border x:Name="RestartNote" Style="{StaticResource RowStyle}" MinHeight="0" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE7BA;" FontSize="16" Foreground="{ThemeResource SystemFillColorCautionBrush}" VerticalAlignment="Center" />
                                <TextBlock Style="{StaticResource RowDescription}" VerticalAlignment="Center"
                                           Text="OptiScaler reads these only when the game starts: its in-game menu can't change them, or asks for a restart. Set them here, then press Play." />
                            </StackPanel>
                        </Border>
                        <Border x:Name="IniRows" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- The OptiScaler wiki entry: the last section of the OptiScaler tab (built in code the first time the tab is shown). -->
            <Border x:Name="OptiWikiHost" Visibility="Collapsed" />
            <!-- The OptiScaler tab's last section: release notes of the stable and nightly channels (built in code). -->
            <Border x:Name="OptiNotesHost" Visibility="Collapsed" />

            <!-- 3c. Steam achievements, read from Steam's own stats files. The tab shows only when Steam has them on this PC. -->
            <Border x:Name="AchCard" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                <StackPanel Spacing="12">
                    <Grid ColumnSpacing="10" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="2" VerticalAlignment="Center">
                            <TextBlock Text="Achievements" Style="{StaticResource SectionTitle}" />
                            <TextBlock x:Name="AchSummary" Style="{StaticResource RowDescription}" />
                        </StackPanel>
                        <SelectorBar x:Name="AchFilterBar" Grid.Column="1" VerticalAlignment="Center" SelectionChanged="AchFilter_SelectionChanged">
                            <SelectorBarItem Text="All" Tag="all" IsSelected="True" />
                            <SelectorBarItem Text="Unlocked" Tag="unlocked" />
                            <SelectorBarItem Text="Locked" Tag="locked" />
                        </SelectorBar>
                    </Grid>
                    <ProgressBar x:Name="AchProgress" Maximum="1" />
                    <Grid x:Name="AchGrid" ColumnSpacing="8" RowSpacing="8" />
                </StackPanel>
            </Border>
        </StackPanel>
        </Grid>
    </ScrollViewer>

    <!-- The tab row while the page is scrolled past it: pinned to the top, on an acrylic strip. -->
    <Border x:Name="StickyBar" VerticalAlignment="Top" Visibility="Collapsed" Margin="0,0,14,0" SizeChanged="StickyBar_SizeChanged"
            Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
        <Border x:Name="StickySlot" MaxWidth="2600" Padding="20,8,20,8" />
    </Border>

    <!-- PCGamingWiki's contents column while the tab bar is pinned: held here, beside its place in the page, under the bar. -->
    <Border x:Name="TocPin" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed" />

    <!-- The game's properties (the gear), Steam style: a window over the dimmed page, built in code (GamePage.Menu.cs). -->
    <Grid x:Name="PropsOverlay" Visibility="Collapsed" Background="#99000000" IsTabStop="True" Tapped="PropsOverlay_Tapped" KeyDown="PropsOverlay_KeyDown" />
    </Grid>
</Page>
