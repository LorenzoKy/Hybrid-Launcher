<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="HybridLauncher.Views.HardwarePage"
    NavigationCacheMode="Required"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled">
        <StackPanel x:Name="Root" MaxWidth="2600" Padding="20,4,20,32" Spacing="12">

            <!-- Header strip, in the banner's style. -->
            <Grid CornerRadius="{StaticResource OverlayCornerRadius}" Padding="24,20" MinHeight="120">
                <Grid.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FF1A0B33" Offset="0" />
                        <GradientStop Color="#FF2A1060" Offset="0.55" />
                        <GradientStop Color="#FF0A3A48" Offset="1" />
                    </LinearGradientBrush>
                </Grid.Background>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Spacing="4">
                    <TextBlock Text="MY PC" Foreground="#CCFFFFFF" FontSize="12" FontWeight="SemiBold" CharacterSpacing="200" />
                    <TextBlock x:Name="MachineTitle" Text="My PC" Foreground="White" Style="{StaticResource TitleLargeTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="MachineSubtitle" Foreground="#DDFFFFFF" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Style="{StaticResource BannerButton}" VerticalAlignment="Top" Click="Refresh_Click" ToolTipService.ToolTip="Read the hardware and the display settings again">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        <TextBlock Text="Refresh" />
                    </StackPanel>
                </Button>
            </Grid>

            <ProgressRing x:Name="LoadingRing" IsActive="True" HorizontalAlignment="Center" Margin="0,40" />

            <StackPanel x:Name="Body" Spacing="12" Visibility="Collapsed">
                <!-- Hardware first: what this PC is. -->
                <TextBlock Text="HARDWARE" Style="{StaticResource GroupHeader}" Margin="2,6,0,0" />
                <!-- Cards in rows of equal height, laid out by code. -->
                <Grid x:Name="CardsGrid" ColumnSpacing="12" />

                <!-- What the graphics card runs, with exact versions: one column per kind (upscaling, frame generation, ...). -->
                <TextBlock Text="UPSCALING AND FRAME GENERATION" Style="{StaticResource GroupHeader}" Margin="2,10,0,0" />
                <StackPanel x:Name="TechPanel" Spacing="12" />

                <!-- Display and graphics: the screens on the left, the Windows switches for games on the right (stacked when narrow). -->
                <TextBlock Text="DISPLAYS AND WINDOWS SETTINGS" Style="{StaticResource GroupHeader}" Margin="2,10,0,0" />
                <Grid x:Name="TopGrid" ColumnSpacing="12" RowSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.6*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel x:Name="DisplaysPanel" Spacing="12" VerticalAlignment="Stretch" />
                    <Border x:Name="SwitchesHost" Grid.Column="1" VerticalAlignment="Stretch" />
                </Grid>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Page>
